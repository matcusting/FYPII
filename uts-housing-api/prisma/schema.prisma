generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LANDLORD
  ADMIN
  LAWYER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum VerificationMethod {
  EMAIL_DOMAIN
  MANUAL
  DOCUMENTS
}

enum LandlordKind {
  INDIVIDUAL
  COMPANY
}

enum PropertyAuthorityKind {
  OWNER
  AGENT
  SUBLETTING
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
  ACCOUNT_INVITE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  PAUSED
  RENTED
  ARCHIVED
}

enum StudentGender {
  MALE
  FEMALE
  UNDISCLOSED
}

enum ListingGenderPreference {
  ALL
  MALE
  FEMALE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EmailJobStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                     String                    @id @default(uuid())
  name                   String
  email                  String                    @unique
  passwordHash           String
  roles                  Role[]                    @default([STUDENT])
  emailVerifiedAt        DateTime?
  studentVerified        Boolean                   @default(false)
  studentVerifiedUntil   DateTime?                 @db.Date
  verificationStatus     VerificationStatus       @default(UNVERIFIED)
  mfaSecretEncrypted     String?
  mfaPendingEncrypted    String?
  mfaPendingCreatedAt    DateTime?
  mfaRecoveryHashes      String[]                  @default([])
  mfaLastUsedStep        Int?
  mfaFailedAttempts      Int                       @default(0)
  mfaLockedUntil         DateTime?
  status                 AccountStatus             @default(ACTIVE)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  profile                Profile?
  phoneChallenge         PhoneVerificationChallenge?
  roommateProfile        RoommateProfile?
  sessions               Session[]
  authTokens             AuthToken[]
  verifications          StudentVerification[]
  landlordVerifications  LandlordVerification[]
  propertyAuthorizations PropertyAuthorization[]
  assignedIdentityCases  LandlordVerification[]      @relation("IdentityLawyer")
  assignedPropertyCases  PropertyAuthorization[]     @relation("PropertyLawyer")
  listings               Listing[]
  favorites              Favorite[]
  inquiriesSent          Inquiry[]                 @relation("InquirySender")
  inquiriesReceived      Inquiry[]                 @relation("InquiryRecipient")
  inquiryMessages        InquiryMessage[]
  connectionsSent        ConnectionRequest[]       @relation("ConnectionSender")
  connectionsReceived    ConnectionRequest[]       @relation("ConnectionRecipient")
  connectionMessages     ConnectionMessage[]
  blocksInitiated        UserBlock[]               @relation("Blocker")
  blocksReceived         UserBlock[]               @relation("Blocked")
  reviews                Review[]
  reviewRevisions        ReviewRevision[]
  reports                Report[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  deletionRequests       DeletionRequest[]
  auditActions           AuditLog[]
  mediaUploads           MediaUpload[]

  @@index([studentVerifiedUntil])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  device       String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  mfaVerifiedAt DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String        @unique
  failedAttempts Int      @default(0)
  kind      AuthTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Profile {
  userId              String    @id
  displayName         String
  phone               String?
  phoneVerifiedAt     DateTime?
  university          String?
  bio                 String?
  preferredLocation   String?
  budgetMin           Decimal?  @db.Decimal(12, 2)
  budgetMax           Decimal?  @db.Decimal(12, 2)
  preferredMoveInDate DateTime? @db.Date
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhoneVerificationChallenge {
  userId         String    @id
  phone          String
  deliveryMode   String    @default("localOutbox")
  codeHash       String
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  verifiedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentVerification {
  id           String             @id @default(uuid())
  userId       String
  method       VerificationMethod
  university   String
  proofKey     String?
  studentIdKey String?
  offerLetterKey String?
  note         String?
  status       VerificationStatus @default(PENDING)
  enrollmentCheckStatus String @default("NOT_CHECKED")
  enrollmentCheckReference String?
  enrollmentCheckedAt DateTime?
  studyEndsAt  DateTime? @db.Date
  evidenceRetainUntil DateTime? @db.Date
  evidenceHoldAt DateTime?
  evidenceHoldReason String?
  reason       String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([status, evidenceRetainUntil])
}

model LandlordVerification {
  id                String             @id @default(uuid())
  userId            String
  kind              LandlordKind
  identityKey       String?
  companyKey        String?
  representationKey String?
  status            VerificationStatus @default(PENDING)
  reason            String?
  reviewerSourceReference String?
  identityMatched   Boolean            @default(false)
  companyRegistryChecked Boolean       @default(false)
  lawyerId          String?
  lawyerAssignedAt  DateTime?
  lawyerDecision    String?
  lawyerReason      String?
  lawyerSourceReference String?
  lawyerIdentityMatched Boolean @default(false)
  lawyerCompanyRegistryChecked Boolean @default(false)
  lawyerReviewedAt  DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  evidenceHoldAt    DateTime?
  evidenceHoldReason String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyer            User?              @relation("IdentityLawyer", fields: [lawyerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([lawyerId, status, createdAt])
}

model PropertyAuthorization {
  id              String                @id @default(uuid())
  listingId       String
  requesterId     String
  kind            PropertyAuthorityKind
  proofKey        String?
  supportingKey   String?
  addressSnapshot String
  status          VerificationStatus    @default(PENDING)
  reason          String?
  reviewerSourceReference String?
  authorityChecked Boolean             @default(false)
  addressMatched  Boolean              @default(false)
  lawyerId          String?
  lawyerAssignedAt  DateTime?
  lawyerDecision    String?
  lawyerReason      String?
  lawyerSourceReference String?
  lawyerAuthorityChecked Boolean @default(false)
  lawyerAddressMatched Boolean @default(false)
  lawyerReviewedAt  DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  evidenceHoldAt  DateTime?
  evidenceHoldReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  listing         Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester       User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  lawyer          User?                 @relation("PropertyLawyer", fields: [lawyerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId, createdAt])
  @@index([requesterId, createdAt])
  @@index([lawyerId, status, createdAt])
}

model Campus {
  id          String    @id @default(uuid())
  name        String
  university  String
  latitude    Float
  longitude   Float
  domains     String[]  @default([])
  active      Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  updatedById String?
  listings    Listing[]
}

model Amenity {
  id       String           @id @default(uuid())
  name     String           @unique
  slug     String           @unique
  listings ListingAmenity[]
}

model Listing {
  id                String           @id @default(uuid())
  ownerId           String
  campusId          String
  title             String
  description       String
  propertyType      String
  roomType          String
  genderPreference  ListingGenderPreference @default(ALL)
  rent              Decimal          @db.Decimal(12, 2)
  currency          String           @default("MYR")
  deposit           Decimal          @db.Decimal(12, 2)
  availableFrom     DateTime         @db.Date
  approximateArea   String
  latitude          Float?
  longitude         Float?
  distanceKm        Float?
  address           String?
  showExactLocation Boolean          @default(false)
  houseRules        String?
  contactMethod     String           @default("IN_APP")
  furnished         Boolean          @default(false)
  status            ListingStatus    @default(DRAFT)
  lastConfirmedAt   DateTime?
  moderationReason  String?
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  owner             User             @relation(fields: [ownerId], references: [id])
  campus            Campus           @relation(fields: [campusId], references: [id])
  photos            ListingPhoto[]
  amenities         ListingAmenity[]
  favorites         Favorite[]
  inquiries         Inquiry[]
  reviews           Review[]
  propertyAuthorizations PropertyAuthorization[]

  @@index([status, campusId, rent])
  @@index([availableFrom])
  @@index([ownerId])
  @@index([status, campusId, distanceKm])
}

model ListingPhoto {
  id         String   @id @default(uuid())
  listingId  String
  storageKey String   @unique
  url        String?
  mimeType   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model MediaUpload {
  id         String   @id @default(uuid())
  ownerId    String
  storageKey String   @unique
  mimeType   String
  size       Int
  purpose    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, purpose])
}

model Inquiry {
  id          String           @id @default(uuid())
  listingId   String
  senderId    String
  recipientId String
  message     String
  status      String           @default("OPEN")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  listing     Listing          @relation(fields: [listingId], references: [id])
  sender      User             @relation("InquirySender", fields: [senderId], references: [id])
  recipient   User             @relation("InquiryRecipient", fields: [recipientId], references: [id])
  messages    InquiryMessage[]

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model InquiryMessage {
  id        String   @id @default(uuid())
  inquiryId String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([inquiryId, createdAt])
}

model RoommateProfile {
  userId              String    @id
  displayName         String
  gender              StudentGender @default(UNDISCLOSED)
  university          String?
  bio                 String?
  preferredLocation   String?
  budgetMin           Decimal?  @db.Decimal(12, 2)
  budgetMax           Decimal?  @db.Decimal(12, 2)
  moveInDate          DateTime? @db.Date
  discoverable        Boolean   @default(false)
  lifestyle           Json      @default("{}")
  roommatePreferences Json      @default("{}")
  importanceWeights   Json      @default("{}")
  visibility          Json      @default("{}")
  smokeFreeOnly       Boolean   @default(false)
  petFreeOnly         Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discoverable])
}

model ConnectionRequest {
  id          String              @id @default(uuid())
  senderId    String
  recipientId String
  status      RequestStatus       @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sender      User                @relation("ConnectionSender", fields: [senderId], references: [id])
  recipient   User                @relation("ConnectionRecipient", fields: [recipientId], references: [id])
  messages    ConnectionMessage[]

  @@unique([senderId, recipientId])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model ConnectionMessage {
  id        String            @id @default(uuid())
  requestId String
  senderId  String
  body      String
  createdAt DateTime          @default(now())
  request   ConnectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User              @relation(fields: [senderId], references: [id])

  @@index([requestId, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Review {
  id                    String             @id @default(uuid())
  listingId             String
  landlordId            String
  authorId              String
  experienceKey         String             @default("primary")
  rating                Int
  body                  String
  experienceDescription String
  experienceProofKey    String?            @unique
  experienceProofStatus VerificationStatus @default(PENDING)
  status                ReviewStatus       @default(PENDING)
  ownerResponse         String?
  ownerRespondedAt      DateTime?
  active                Boolean            @default(true)
  revision              Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  listing               Listing            @relation(fields: [listingId], references: [id])
  author                User               @relation(fields: [authorId], references: [id])
  revisions             ReviewRevision[]

  @@unique([authorId, listingId, experienceKey])
  @@index([listingId, status])
}

model ReviewRevision {
  id       String   @id @default(uuid())
  reviewId String
  editorId String
  rating   Int
  body     String
  editedAt DateTime @default(now())
  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  editor   User     @relation(fields: [editorId], references: [id])
}

model Report {
  id               String       @id @default(uuid())
  reporterId       String
  targetType       String
  targetId         String
  category         String
  reason           String
  status           ReportStatus @default(OPEN)
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  reporter         User         @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPreference {
  userId                  String  @id
  emailInquiryUpdates     Boolean @default(true)
  emailConnectionRequests Boolean @default(true)
  emailProductUpdates     Boolean @default(false)
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeletionRequest {
  id          String   @id @default(uuid())
  userId      String
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId, createdAt])
}

model EmailJob {
  id            String         @id @default(uuid())
  to            String
  subject       String
  template      String
  payload       Json
  status        EmailJobStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  createdAt     DateTime       @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}
