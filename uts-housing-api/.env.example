NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://housing:housing_dev_only@127.0.0.1:5432/housing?schema=public
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:5173
# Optional HTTPS address-lookup endpoint. Local development uses public Nominatim
# with a one-request-per-second limit when this is blank. Configure a dedicated
# geocoder before hosting the site; no precise coordinates are returned to clients.
GEOCODER_URL=
EMAIL_FROM=UTS Housing <no-reply@example.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OUTBOX_DIR=./data/outbox
# Optional phone verification. Local outbox is a workflow test only and never
# marks real phone ownership as verified. Real delivery requires a Twilio account.
SMS_PROVIDER=localOutbox
SMS_OUTBOX_DIR=./data/sms-outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
UPLOAD_DIR=./data/uploads
MEDIA_PRIVATE_DIR=./data/private
LANDLORD_IDENTITY_VALID_DAYS=365
PROPERTY_AUTHORIZATION_VALID_DAYS=180
