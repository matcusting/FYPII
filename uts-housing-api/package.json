{
  "name": "uts-housing-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx prisma/migrate.ts",
    "db:deploy": "node --env-file-if-exists=.env --import tsx prisma/migrate.ts",
    "db:deploy:prod": "node --env-file-if-exists=.env dist/prisma/migrate.js",
    "db:init-local": "node --env-file-if-exists=.env --import tsx prisma/local-init.ts",
    "lawyer:provision": "node --env-file-if-exists=.env --import tsx prisma/provision-lawyer.ts",
    "account:invite": "node --env-file-if-exists=.env --import tsx prisma/invite-account.ts",
    "account:invite:prod": "node --env-file-if-exists=.env dist/prisma/invite-account.js",
    "account:mfa-recover": "node --env-file-if-exists=.env --import tsx prisma/recover-privileged-mfa.ts",
    "account:mfa-recover:prod": "node --env-file-if-exists=.env dist/prisma/recover-privileged-mfa.js",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "locations:backfill": "node --env-file-if-exists=.env --import tsx prisma/backfill-locations.ts",
    "email:worker": "node --env-file-if-exists=.env --import tsx src/workers/email.ts",
    "email:check": "node --env-file-if-exists=.env --import tsx src/workers/check-smtp.ts",
    "files:cleanup": "node --env-file-if-exists=.env --import tsx src/workers/file-deletion-cli.ts",
    "files:cleanup:prod": "node --env-file-if-exists=.env dist/src/workers/file-deletion-cli.js",
    "evidence:retention": "node --env-file-if-exists=.env --import tsx src/workers/evidence-retention-cli.ts",
    "evidence:retention:prod": "node --env-file-if-exists=.env dist/src/workers/evidence-retention-cli.js",
    "evidence:recover": "node --env-file-if-exists=.env --import tsx src/workers/evidence-retention-recover.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
