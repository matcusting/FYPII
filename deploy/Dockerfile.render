# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS api-build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/uts-housing-api
COPY uts-housing-api/package.json uts-housing-api/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -s /run/secrets/proxy_ca ]; then NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true; \
    else npm ci --strict-ssl=true; fi
COPY uts-housing-api/ ./
RUN npm run db:generate && npm run build

FROM node:24-bookworm-slim AS frontend-build
WORKDIR /app/uts-housing-frontend
COPY uts-housing-frontend/package.json uts-housing-frontend/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -s /run/secrets/proxy_ca ]; then NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true; \
    else npm ci --strict-ssl=true; fi
COPY uts-housing-frontend/ ./
# These are public details supplied by the site operator, never credentials.
ENV VITE_OPERATOR_NAME="Marcus Ting Zhong Sheng" \
    VITE_SUPPORT_EMAIL="matcusting@gmail.com" \
    VITE_API_BASE_URL="/api/v1"
RUN npm run build

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY --from=api-build --chown=node:node /app/uts-housing-api /app/uts-housing-api
COPY --from=frontend-build --chown=node:node /app/uts-housing-frontend/dist /app/site
COPY --chown=node:node deploy/render-gateway.mjs deploy/render-start.sh /app/deploy/
RUN mkdir -p /srv/housing/private && chown -R node:node /srv/housing
USER node
EXPOSE 10000
CMD ["bash", "/app/deploy/render-start.sh"]
