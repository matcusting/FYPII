# Copy to deploy/.env.production, chmod 600, and replace every example value.
# Never commit the actual file or put passwords directly in it.
SITE_DOMAIN=housing.example.invalid
ACME_EMAIL=operator@example.invalid
DEPLOY_TAG=local

# Host paths to mode-0600 files containing a single secret each.
DB_PASSWORD_FILE_HOST=/absolute/private/path/db_password
SESSION_SECRET_FILE_HOST=/absolute/private/path/session_secret
MFA_ENCRYPTION_KEY_FILE_HOST=/absolute/private/path/mfa_encryption_key
SMTP_PASSWORD_FILE_HOST=/absolute/private/path/smtp_password
BACKUP_PASSPHRASE_FILE_HOST=/absolute/private/path/backup_passphrase

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-with-smtp-account
EMAIL_FROM="UTS Housing <no-reply@example.invalid>"
GEOCODER_URL=https://geocoder.example.invalid/search

# The operator's approved public name and contact are embedded in the frontend build.
VITE_OPERATOR_NAME=Marcus Ting Zhong Sheng
VITE_SUPPORT_EMAIL=matcusting@gmail.com

# This must be an off-device mounted filesystem, prepared by the operator.
# Put a .uts-housing-offsite-ready marker in that directory after verifying it.
BACKUP_DESTINATION=/absolute/offsite/housing-backups
# RAM-backed temporary space for the unencrypted backup staging area (bytes).
BACKUP_TMPFS_SIZE=2147483648
