# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/uts-housing-api
COPY uts-housing-api/package.json uts-housing-api/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -s /run/secrets/proxy_ca ]; then \
      NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true; \
    else \
      npm ci --strict-ssl=true; \
    fi
COPY uts-housing-api/ ./
RUN npm run db:generate && npm run build && npm prune --omit=dev --legacy-peer-deps

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app/uts-housing-api
COPY --from=build --chown=node:node /app/uts-housing-api/package.json ./package.json
COPY --from=build --chown=node:node /app/uts-housing-api/dist ./dist
COPY --from=build --chown=node:node /app/uts-housing-api/node_modules ./node_modules
COPY --from=build --chown=node:node /app/uts-housing-api/prisma/migrations ./prisma/migrations
COPY --from=build --chown=node:node /app/uts-housing-api/scripts/with-production-secrets.mjs ./scripts/with-production-secrets.mjs
RUN mkdir -p /srv/housing/private && chown -R node:node /srv/housing
USER node
EXPOSE 3001
CMD ["bash", "-lc", "node dist/prisma/migrate.js && node dist/src/workers/email.js"]
