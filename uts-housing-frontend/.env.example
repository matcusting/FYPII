# Frontend requests are same-origin by default. The local Vite proxy forwards /api to this server.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Optional official support mailbox shown on the Help page. Leave empty until an operator owns it.
VITE_SUPPORT_EMAIL=
# Optional public legal name of the individual site operator. Do not fill until
# the operator has approved displaying their name in the formal privacy notice.
VITE_OPERATOR_NAME=
