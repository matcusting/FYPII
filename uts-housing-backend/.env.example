# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://uts:uts_dev_password@localhost:5432/uts_housing
# Used by `npm test` (a separate, disposable database)
TEST_DATABASE_URL=postgresql://uts:uts_dev_password@localhost:5432/uts_housing_test
# Where the React app runs (CORS + links in emails)
FRONTEND_ORIGIN=http://localhost:5173
# Session lifetime in days
SESSION_TTL_DAYS=7
# Local folder for uploaded listing photos
UPLOAD_DIR=uploads
# Private folder for verification documents (offer letters, IC, title deeds). Never expose it publicly.
PRIVATE_UPLOAD_DIR=private-uploads
# Optional SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# When empty, emails are printed to the server console and written to logs/mail.log
SMTP_URL=
EMAIL_FROM=no-reply@uts-housing.local
# Listing availability upkeep: remind owners after N days without confirmation,
# pause the listing automatically after M days. The job runs every JOB_INTERVAL_MINUTES.
STALE_LISTING_DAYS=30
AUTO_PAUSE_LISTING_DAYS=45
JOB_INTERVAL_MINUTES=60
# Where uploaded files are kept: disk (default) or database (hosts without a permanent disk, e.g. Render free)
STORAGE_DRIVER=disk
# Built React app to serve from the API (single-origin deployment), e.g. ../uts-housing-frontend/dist
FRONTEND_DIST=
# Online demo only: passwords for the seeded admin and legal reviewer accounts (12+ characters).
# In production the seed refuses to run without them and never wipes a database that already has users.
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_PASSWORD=
