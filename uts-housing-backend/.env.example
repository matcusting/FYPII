# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://uts:uts_dev_password@localhost:5432/uts_housing
# Used by `npm test` (a separate, disposable database)
TEST_DATABASE_URL=postgresql://uts:uts_dev_password@localhost:5432/uts_housing_test
# Where the React app runs (CORS + links in emails)
FRONTEND_ORIGIN=http://localhost:5173
# Session lifetime in days
SESSION_TTL_DAYS=7
# Local folder for uploaded listing photos
UPLOAD_DIR=uploads
# Optional SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# When empty, emails are printed to the server console and written to logs/mail.log
SMTP_URL=
EMAIL_FROM=no-reply@uts-housing.local
