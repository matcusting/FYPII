// UTS Housing & Roommate Finder — database schema (PostgreSQL)
// Entities follow Chapter 4 of the FYP report (Users, Landlords, Listings, Reviews)
// extended with the tables described in PROJECT_REQUIREMENTS.md section 9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LANDLORD
  ADMIN
  LEGAL_REVIEWER // checks landlord identity and property ownership documents
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
}

enum VerificationType {
  STUDENT
  LANDLORD
}

enum VerificationMethod {
  EMAIL_DOMAIN // legacy: approved automatically from the university e-mail
  MANUAL // legacy: written note only
  DOCUMENTS // uploaded documents reviewed by a person
}

// Private documents uploaded for verification or property checks (never public).
enum DocumentKind {
  OFFER_LETTER // student: university offer letter (PDF)
  STUDENT_CARD // student: photo of the student card
  IDENTITY_CARD // landlord: MyKad / passport
  COMPANY_REGISTRATION // landlord company: SSM registration
  PROPERTY_TITLE // property: title deed / ownership proof
  TENANCY_AGREEMENT // property: head tenancy agreement (when subletting)
  OWNER_AUTHORISATION // property: owner's letter allowing the landlord to rent it out
  OTHER_PROPERTY // property: any other supporting document
}

// Legal check of a listing's ownership / right-to-rent documents.
enum LegalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  PAUSED
  RENTED
  ARCHIVED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConversationType {
  LISTING_INQUIRY
  ROOMMATE
  SUPPORT
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTarget {
  LISTING
  USER
  REVIEW
  MESSAGE
}

// Self-reported by students; used for roommate matching and gender-restricted rentals.
enum Gender {
  MALE
  FEMALE
}

// Which roommates a student wants to be matched with.
enum RoommateGenderPreference {
  SAME // same gender only
  ANY
}

// Who a landlord rents a listing to.
enum GenderRestriction {
  ANY
  MALE_ONLY
  FEMALE_ONLY
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model University {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  emailDomains String[]
  // Student e-mails must look like <studentId>@domain (e.g. bcs12345678@student.uts.edu.my)
  requireStudentIdEmail Boolean @default(true)
  campuses     Campus[]
  createdAt    DateTime  @default(now()) @db.Timestamptz
}

model Campus {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  latitude     Decimal    @db.Decimal(9, 6)
  longitude    Decimal    @db.Decimal(9, 6)
  listings     Listing[]
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@unique([universityId, name])
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  email              String        @unique // always stored lower-cased
  passwordHash       String
  role               Role
  status             AccountStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?     @db.Timestamptz
  // Student-only fields
  studentId          String?       @unique
  gender             Gender? // required for students (registration); null for landlords/admins
  major              String?
  academicYear       String?
  studentVerifiedAt  DateTime?     @db.Timestamptz
  // Landlord-only fields
  phone              String?
  landlordVerifiedAt DateTime?     @db.Timestamptz
  bio                String?
  // Notification preferences (FR-09). Security e-mails (verification, password reset) are always sent.
  emailNotifications Boolean       @default(true)
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  emailTokens           EmailVerificationToken[]
  verifications         Verification[]       @relation("VerificationSubject")
  reviewedVerifications Verification[]       @relation("VerificationReviewer")
  listings              Listing[]
  favorites             Favorite[]
  lifestyle             LifestyleProfile?
  sentRequests          ConnectionRequest[]  @relation("RequestSender")
  receivedRequests      ConnectionRequest[]  @relation("RequestRecipient")
  blocksMade            Block[]              @relation("Blocker")
  blocksReceived        Block[]              @relation("Blocked")
  participations        ConversationParticipant[]
  messages              Message[]
  reviewsWritten        Review[]             @relation("ReviewAuthor")
  reviewsReceived       Review[]             @relation("ReviewLandlord")
  reports               Report[]             @relation("Reporter")
  resolvedReports       Report[]             @relation("Resolver")
  notifications         Notification[]
  auditLogs             AuditLog[]
  documents             Document[]
  legalReviews          Listing[]            @relation("LegalReviewer")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
}

// Student-status and landlord-identity verification queue (proof never public)
model Verification {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  user         User               @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  type         VerificationType
  method       VerificationMethod
  status       VerificationStatus @default(PENDING)
  note         String?            // applicant's supporting statement
  decisionNote String?
  reviewedById String?            @db.Uuid
  reviewedBy   User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?          @db.Timestamptz
  createdAt    DateTime           @default(now()) @db.Timestamptz
  documents    Document[]

  @@index([status, type])
}

model Document {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @db.Uuid
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  verificationId String?       @db.Uuid
  verification   Verification? @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  listingId      String?       @db.Uuid
  listing        Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind           DocumentKind
  objectKey      String        @unique // random file name in PRIVATE_UPLOAD_DIR
  originalName   String
  mimeType       String
  sizeBytes      Int
  supersededAt   DateTime?     @db.Timestamptz // e.g. replaced after the listing address changed
  createdAt      DateTime      @default(now()) @db.Timestamptz

  @@index([verificationId])
  @@index([listingId])
}

/// File content when STORAGE_DRIVER=database (hosts without a permanent disk).
model StoredFile {
  objectKey String   @id // same key as ListingPhoto.objectKey / Document.objectKey
  bucket    String // 'public' (photos) or 'private' (verification documents)
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now()) @db.Timestamptz
}

model Amenity {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique
  listings ListingAmenity[]
}

model Listing {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @db.Uuid
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campusId        String        @db.Uuid
  campus          Campus        @relation(fields: [campusId], references: [id])
  title           String
  description     String        @default("")
  roomType        String
  rent            Decimal       @db.Decimal(12, 2)
  deposit         Decimal       @default(0) @db.Decimal(12, 2)
  currency        String        @default("MYR") @db.Char(3)
  distanceKm      Decimal       @db.Decimal(6, 2) // distance to campus, entered by the landlord
  address         String? // property address — students can open it in Google Maps
  mapUrl          String? // optional Google Maps link pasted by the landlord (more precise than the address)
  approximateArea String?
  furnished       Boolean       @default(false)
  houseRules      String?
  genderRestriction GenderRestriction @default(ANY) // e.g. "women only"
  availableFrom   DateTime?     @db.Date
  status          ListingStatus @default(DRAFT)
  rejectionReason String?
  // Legal check of ownership / right-to-rent documents (by the legal reviewer)
  legalStatus       LegalStatus @default(NOT_SUBMITTED)
  legalNote         String?
  legalReviewedAt   DateTime?   @db.Timestamptz
  legalReviewedById String?     @db.Uuid
  legalReviewedBy   User?       @relation("LegalReviewer", fields: [legalReviewedById], references: [id], onDelete: SetNull)
  lastConfirmedAt DateTime      @default(now()) @db.Timestamptz
  staleReminderAt DateTime?     @db.Timestamptz // when the "please reconfirm" reminder was last sent
  viewCount       Int           @default(0)
  publishedAt     DateTime?     @db.Timestamptz
  deletedAt       DateTime?     @db.Timestamptz
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  amenities     ListingAmenity[]
  photos        ListingPhoto[]
  favorites     Favorite[]
  reviews       Review[]
  conversations Conversation[]
  documents     Document[]

  @@index([status, campusId, rent])
  @@index([availableFrom])
  @@index([ownerId])
  @@index([status, lastConfirmedAt])
  @@index([status, genderRestriction])
}

model ListingAmenity {
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenityId String  @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

model ListingPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  objectKey String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
}

model Favorite {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([userId, listingId])
}

// Habit profile used by the roommate-matching engine (private by default)
model LifestyleProfile {
  userId        String    @id @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySchedule String?
  cleanliness   String?
  smoking       String?
  noise         String?
  guests        String?
  pets          String?
  weights       Json      @default("{}") // optional importance per habit (1-3)
  smokeFreeOnly Boolean   @default(false) // hard deal-breaker
  roommateGender RoommateGenderPreference @default(SAME) // hard filter in matching
  budgetMin     Int?
  budgetMax     Int?
  moveInDate    DateTime? @db.Date
  preferredArea String?
  discoverable  Boolean   @default(false)
  updatedAt     DateTime  @updatedAt @db.Timestamptz
}

model Block {
  blockerId String   @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([blockerId, blockedId])
}

model ConnectionRequest {
  id          String        @id @default(uuid()) @db.Uuid
  senderId    String        @db.Uuid
  sender      User          @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String        @db.Uuid
  recipient   User          @relation("RequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  message     String?
  score       Int?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  respondedAt DateTime?     @db.Timestamptz

  @@unique([senderId, recipientId])
}

// In-app messaging (listing inquiries, accepted roommate connections, support)
model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  type         ConversationType
  listingId    String?                   @db.Uuid
  listing      Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now()) @db.Timestamptz
  updatedAt    DateTime                  @default(now()) @db.Timestamptz
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now()) @db.Timestamptz

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@index([conversationId, createdAt])
}

model Review {
  id               String           @id @default(uuid()) @db.Uuid
  listingId        String           @db.Uuid
  listing          Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  landlordId       String           @db.Uuid
  landlord         User             @relation("ReviewLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  authorId         String           @db.Uuid
  author           User             @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  rating           Int
  body             String
  stayFrom         DateTime         @db.Date
  stayTo           DateTime?        @db.Date
  proofNote        String           // evidence of genuine rental experience (seen by admins only)
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  reply            String?
  repliedAt        DateTime?        @db.Timestamptz
  editHistory      Json             @default("[]")
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  @@unique([listingId, authorId]) // one active review per student per listing
  @@index([listingId, moderationStatus])
  @@index([landlordId, moderationStatus])
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @db.Uuid
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTarget
  targetId     String       @db.Uuid
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolution   String?
  resolvedById String?      @db.Uuid
  resolvedBy   User?        @relation("Resolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?    @db.Timestamptz
  createdAt    DateTime     @default(now()) @db.Timestamptz

  @@index([status])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}
